# Shine Bot v2 — environment variables. Copy into Vercel (Project → Settings →
# Environment Variables) or .env.local for local dev. NEVER commit real values.

# ── Required ─────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather (previous value appeared in repository history; rotate before deployment)
TELEGRAM_BOT_TOKEN=
# Groq API key (previous value appeared in repository history; rotate before deployment)
GROQ_API_KEY=
# Google Sheets
GOOGLE_SHEET_ID=
# Service-account JSON as a single string (wrap the key file in single quotes).
# The service account needs Editor access to the sheet.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
# Private admin group chat id (the mentorship inbox; e.g. -1003881055286 —
# your existing group, visible in the old webhook.js)
ADMIN_GROUP_ID=

# ── Strongly recommended ─────────────────────────────────────────────────────
# Secret Telegram includes in every webhook call (x-telegram-bot-api-secret-token).
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Blocks strangers from calling the cron endpoint manually. Vercel sends it
# automatically as `Authorization: Bearer $CRON_SECRET` on scheduled runs.
CRON_SECRET=
# Telegram user ids (comma-separated) allowed to run admin commands. Get yours
# by sending /id in the admin group. Empty = every member of the private group
# is trusted.
ADMIN_TELEGRAM_IDS=
# Secret for /api/telegram/setup and /api/test-send. Generate: openssl rand -hex 24
ADMIN_API_SECRET=

# ── Optional: AI models (defaults work; change here, never in code) ──────────
# Defaults: openai/gpt-oss-120b for chat/tutor/motivation, openai/gpt-oss-20b
# for classifier/escalation (fast + cheap). llama-3.3-70b-versatile and
# llama-3.1-8b-instant are retired on Groq self-serve tiers.
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_MODEL_TUTOR=openai/gpt-oss-120b
GROQ_MODEL_CLASSIFIER=openai/gpt-oss-20b
GROQ_MODEL_ESCALATION=openai/gpt-oss-20b
GROQ_MODEL_MOTIVATION=openai/gpt-oss-120b
# Fallback chain when a model id stops existing (comma-separated)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b,openai/gpt-oss-20b
# gpt-oss reasoning effort (low | medium | high)
GROQ_REASONING_CHAT=low
GROQ_REASONING_TUTOR=medium

# ── Optional: Redis store (recommended once message volume grows) ────────────
# When both are set, message mappings/conversations/dedup live in Redis with
# TTLs instead of Google Sheets bot_* tabs. Vercel KV (Upstash) provides these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Force a backend: auto (default) | redis | sheets | memory
STORE_TYPE=auto

# ── Optional: tuning ─────────────────────────────────────────────────────────
CONVERSATION_HISTORY_TURNS=12
MAPPING_RETENTION_DAYS=30
CONVERSATION_RETENTION_DAYS=60
BROADCAST_SEND_DELAY_MS=80
MAX_BROADCAST_BATCH=600
